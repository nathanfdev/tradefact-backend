        [HttpDelete]
        [Route("{id:guid}/Contact/{Contactid:guid}")]
        public async Task<IActionResult> DeleteContact(string id, string contactid)
        {
            Organisation org = await GetOrganisationWithContacts(id);
            if (org == null || org.Contacts == null || !org.Contacts.Any(q => q.Id == new Guid(contactid)))
            {
                return new NotFoundResult();
            }
            Contact contact = org.Contacts.Single(q => q.Id == new Guid(contactid));
            contact.IsActive = false;
            _ = await _context.SaveChangesAsync();
            return Ok();
        }

        private async Task<Organisation> GetOrganisation(string id)
        {
            Organisation org = await _context.Organisations.SingleOrDefaultAsync(q => q.ParentId == this.OrganisationId && q.Id == new Guid(id));
            if (org == null)
            {
                return null;
            }
            return org;
        }

        private async Task<Organisation> GetOrganisationWithNotes(string id)
        {
            Organisation org = await _context.Organisations.Include(i => i.Notes).SingleOrDefaultAsync(q => q.ParentId == this.OrganisationId && q.Id == new Guid(id));
            if (org == null)
            {
                return null;
            }
            return org;
        }

        private async Task<Organisation> GetOrganisationWithAddress(string id)
        {
            Organisation org = await _context.Organisations.Include(i => i.Addresses).ThenInclude(address => address.Country).SingleOrDefaultAsync(q => q.ParentId == this.OrganisationId && q.Id == new Guid(id));
            if (org == null)
            {
                return null;
            }
            return org;
        }

        private async Task<Organisation> GetOrganisationWithContacts(string id)
        {
            Organisation org = await _context.Organisations.Include(i => i.Contacts).ThenInclude(contact => contact.Email).SingleOrDefaultAsync(q => q.ParentId == this.OrganisationId && q.Id == new Guid(id));
            if (org == null)
            {
                return null;
            }
            return org;
        }

    }
}