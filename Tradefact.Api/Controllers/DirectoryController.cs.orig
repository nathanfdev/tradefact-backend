            } else if (this.OrganisationType == OrganisationTypeEnum.SUPPLIER)
            {
                IQueryable<SupplierInfo> query = _context.Suppliers.Where(q => q.ParentId == this.OrganisationId).OrderByDescending(x => x.CreationDateInternal);
                if (search != null && search.Length > 0)
