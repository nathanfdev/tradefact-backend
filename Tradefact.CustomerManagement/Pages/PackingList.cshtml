@page
@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers
@model Tradefact.Portal.Pages.PackingListModel
@{
}

<style>
    .route-group {
        display: flex;
        flex-direction: row;
        justify-content: end;
    }

    .route-leg {
        flex-grow: 1;
        flex-basis: 0;
        background-color: #edede4;
        margin-left: 5px;
        padding: 5px;
    }

    .route-element {
        font-size: .75em;
        display: block;
    }

    .route-label {
        display: block;
        border-bottom: 2px solid;
        border-bottom-color: #92a8d1;
    }

    .route-text {
        display: block;
        font-weight: bold
    }
</style>

<div class="min-h-screen bg-white border-t-8 border-gray-700 h-2" " style="min-height: 600px">

    <div class="container flex py-1 px-4">
        <div class="flex flex-row justify-between mb-8 w-full">
            <div class="w-3/6">
                <div class="mb-2 md:mb-1 md:flex items-center">
                    <label class="w-36 text-gray-800 block font-bold text-sm uppercase tracking-wide">Shipment #</label>
                    <span class="mr-4 inline-block hidden md:block">:</span>
                    <div class="flex-1">
                        <input class="bg-gray-200 appearance-none border-2 border-gray-200 rounded md:w-60 py-2 px-4 text-gray-700 leading-tight focus:outline-none focus:bg-white focus:border-blue-500" id="inline-full-name" type="text" value="@Model.Shipment.Shipment.Reference">
                    </div>
                </div>

                <div class="mb-2 md:mb-1 md:flex items-center">
                    <label class="w-36 text-gray-800 block font-bold text-sm uppercase tracking-wide">Order Date</label>
                    <span class="mr-4 inline-block hidden md:block">:</span>
                    <div class="flex-1">
                        <input class="bg-gray-200 appearance-none border-2 border-gray-200 rounded md:w-48 py-2 px-4 text-gray-700 leading-tight focus:outline-none focus:bg-white focus:border-blue-500" type="text" value="@Model.Shipment.Shipment.CollectionDate.GetValueOrDefault().ToString("dd MMMM yyyy")" readonly="readonly">
                    </div>
                </div>

                <div class="mb-2 md:mb-1 md:flex items-center">
                    <label class="w-36 text-gray-800 block font-bold text-sm uppercase tracking-wide">Goods Ready</label>
                    <span class="mr-4 inline-block hidden md:block">:</span>
                    <div class="flex-1">
                        <input class="bg-gray-200 appearance-none border-2 border-gray-200 rounded md:w-48 py-2 px-4 text-gray-700 leading-tight focus:outline-none focus:bg-white focus:border-blue-500" type="text" value="@Model.Shipment.Shipment.EstimatedDeparturePOL.GetValueOrDefault().ToString("dd MMMM yyyy")" readonly="">
                    </div>
                </div>
            </div>
            <div class="w-3/6">
                <div class="w-full mx-2">
                    <label for="pallet-notes" class="block text-sm font-medium text-gray-700">
                        From
                    </label>
                    <div class="my-2 p-1 bg-white w-full h-full flex border border-gray-200 rounded">
                        <textarea id="about" name="about" rows="3" class="shadow-sm w-full h-full mt-1 block sm:text-sm border border-none rounded-md" placeholder="Shipment from"></textarea>
                    </div>
                </div>
            </div>
        </div>


    </div>

    <div class="container flex py-1 px-4">
        <div class="w-2/6">
            <div class="flex flex-wrap justify-between">
                <div class="w-full">
                    <div class="mb-1 bg-gray-200 appearance-none border-2 border-gray-200 rounded w-full py-2 px-4 text-gray-700 leading-tight focus:outline-none focus:bg-white focus:border-blue-500">
                        <label class="text-gray-800 block mb-1 font-bold text-sm uppercase tracking-wide">Customer:</label>
                        <div>@Model.Shipment.Shipment.Client</div>
                        <div>&nbsp;</div>
                        <div>&nbsp;</div>
                        <div>&nbsp;</div>
                        <div>&nbsp;</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="w-4/6 pl-4">
            <div class="route-group">
                @foreach (var leg in Model.Shipment.Legs)
                {
                    <div class="route-leg">
                        <div class="route-icon">
                        </div>
                        <div class="route-element h-full">
                            <span class="route-label">@leg.Description</span>
                            <span class="route-text">@leg.Name</span>
                            @foreach (var line in leg.NoBlankAddress())
                            {
                                <div class="route-text">@line.ToUpper()</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

