@{
    ViewData["Title"] = "Home Page";
}

<div class="">
    <h1 class="display-4">Create new Relationship</h1>
    <p>Fill out this form to create a new relationship between any two companies.</p>

    <form method="POST">
        <div class="row">
            <div class="form-group col-md-4">
                <label for="inputProvider">Select Provider</label>
                <select name="providerId" class="form-control" id="inputProvider">
                    <option value="dev">select from</option>
                    <option value="prod">any company</option>
                    <option value="prod">with search</option>
                </select>
            </div>
        </div>
        <div class="row">
            <div class="form-group col-md-4">
                <label for="inputClient">Select Client</label>
                <select name="clientId" class="form-control" id="inputClient">
                    <option value="dev">select from</option>
                    <option value="prod">any company</option>
                    <option value="prod">with search</option>
                </select>
            </div>
        </div>
        <div class="row">
            <div class="form-group col-md-4">
                <label for="inputRelationshipType">Select Relationship Type</label>
                <select name="environment" class="form-control" id="inputRelationshipType">
                    <option value="1">Forwarder - Shipper</option>
                    <option value="2">Shipper</option>
                    <option value="3">Supplier</option>
                    <option value="4">Buyer</option>
                </select>
            </div>
        </div>
        <div class="row form-group col-md-2">
            <button disabled type="submit" class="btn btn-primary">Send Invite</button>
        </div>
    </form>
</div>
