@page
@model Tradefact.Portal.Pages.POAcknowledgedModel
@{
}

<div>
    <div class="border-t-8 border-gray-700 h-2"></div>
    <div class="container mx-auto py-6 px-4" style="border-bottom: 1px solid #edf2f9; background-color: #fff;">
        <div class="text-center">
            <h3 class="text-2xl font-bold mb-6 pb-2">Order Status Update</h3>
        </div>
    </div>
    <div class="container mx-auto py-6 px-4">
        <div class="text-center px-4">
            <p class="text-xl font-bold mb-6 pb-2">We have updated @Model.PO.Client with the order status</p>
            <p class="text-xl mb-6 pb-2">While you're here ... why not unlock the full potential of Tradefact?  Register today for automated purchase order management and seamless communication with your suppliers and customers.</p>
            <p class="text-xl mb-6 pb-2">
                You can try Tradefact for 14 days for free.
            </p>
        </div>
        <div class="text-center px-4">
            <a href="https://www.tradefact.com/pricing-plans/" class="text-blue-500 bg-transparent border border-solid border-blue-500 hover:bg-blue-500 hover:text-white active:bg-blue-600 font-bold uppercase px-4 py-2 rounded-lg outline-none focus:outline-none mr-1 mb-1 ease-linear transition-all duration-150">Try it free</a>
        </div>
    </div>
    <div class="container mx-auto py-3 px-4" style="border-bottom: 1px solid #edf2f9; background-color: #fff;">
        <div class="text-center px-4">
            <p class="text-xl italic mt-6">
                Still not ready to register? No problem, continue to access your order and respond.
            </p>
            <div class="text-center px-4 py-6">
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ActivePurchaseOrderId" value="@Model.ActivePurchaseOrderId" />
                    <input type="hidden" asp-for="ActiveSignature" value="@Model.ActiveSignature" />

                    <div class="relative inline-block">
                        <input runat="server" id="btnBackToPO" value="Back" asp-page-handler="Back" class="text-blue-500 bg-transparent border border-solid border-blue-500 hover:bg-blue-500 hover:text-white active:bg-blue-600 font-bold uppercase px-4 py-2 rounded-lg outline-none focus:outline-none mr-1 mb-1 ease-linear transition-all duration-150" type="submit" />
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="container mx-auto py-12 px-4 text-center">
            <div class="flex flex-wrap content-center">
                    <img class="w-64 mx-auto" src="https://app.tradefact.com/images/logo.png" />
            </div>
            <div class="px-1  align-baseline">
                <p class="text-gray-800" x-text="invoice.name">Tradefact Technologies Limited</p>
            </div>
    </div>

</div>
