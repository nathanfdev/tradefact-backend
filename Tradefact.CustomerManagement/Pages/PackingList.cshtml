    <div class="container">
        <packing-list shipmentid="@Model.Shipment.Shipment.Id"></packing-list>
    </div>
</div>

    @section Scripts {
        <script src="js/packing-list/runtime.js" defer></script>
        <script src="js/packing-list/polyfills.js" defer></script>
        <script src="js/packing-list/main.js" defer></script>
    }
